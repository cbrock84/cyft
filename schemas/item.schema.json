{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chrisbrock.io/schemas/cyft/item.schema.json",
  "title": "Cyft item",
  "description": "One distinct thing, after deduplication. Several captures can resolve to one item.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "captures", "first_seen", "status"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.1"] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "kind": {
      "type": "string",
      "enum": ["repository", "product", "service", "dataset", "model", "technique", "article", "person", "claim-only", "unresolved"]
    },
    "name": { "type": "string" },
    "one_line": { "type": "string", "description": "What it is, in the owner's words, not the vendor's." },
    "captures": {
      "description": "The raw things that produced this item. Several captures, one item.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capture_id", "input_type", "captured", "content_hash"],
        "properties": {
          "capture_id": { "type": "string" },
          "input_type": { "type": "string", "enum": ["screenshot", "photo", "pdf", "url", "snippet", "note", "repo-ref"], "description": "A url-list file is expanded at intake into one url capture per line, so it never appears here." },
          "origin": { "type": "string", "description": "Where it came from. A handle, a sender, a domain. Not a primary source." },
          "captured": { "type": "string", "format": "date" },
          "content_hash": { "type": "string" },
          "extracted_path": { "type": "string" },
          "group": { "type": "string", "description": "Set when several captures came from one source post or document." }
        }
      }
    },
    "primary_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "kind": { "type": "string", "enum": ["repository", "license", "official-docs", "pricing-page", "filing", "standard", "reproducible-observation", "third-party-report", "none-found"] },
        "resolved": { "type": "string", "format": "date" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identifier": { "type": "string" },
        "source_available_not_osi": { "type": "boolean" },
        "permits_intended_use": { "type": ["boolean", "null"] },
        "restrictions": { "type": "array", "items": { "type": "string" } },
        "checked": { "type": "string", "format": "date" }
      }
    },
    "first_seen": { "type": "string", "format": "date" },
    "last_reviewed": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["new", "resolved", "verified", "scored", "routed"] },
    "duplicate_of": { "type": ["string", "null"] }
  }
}
